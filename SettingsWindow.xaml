<Window x:Class="DexterType.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="300" Height="380" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F8F9FB">
    <StackPanel Margin="20">
        <TextBlock Text="Цветовая тема" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
        <Button Content="🍬 Сладкая" Margin="0,0,0,8" Click="SetCandyTheme" Padding="8" Background="White"/>
        <Button Content="🌙 Тёмная" Margin="0,0,0,8" Click="SetDarkTheme" Padding="8" Background="White"/>
        <Button Content="⌨ Монохром" Margin="0,0,0,8" Click="SetMonoTheme" Padding="8" Background="White"/>
        <Button Content="🚀 Stamina" Margin="0,0,0,8" Click="SetStaminaTheme" Padding="8" Background="White"/>
        <Button Content="💻 Matrix" Margin="0,0,0,15" Click="SetCyberTheme" Padding="8" Background="White"/>
        <Separator Margin="0,0,0,10"/>
        <TextBlock Text="Музыкальное сопровождение" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="MusicBox" Margin="0,0,0,15" SelectionChanged="MusicChanged">
            <ComboBoxItem Content="Без музыки" IsSelected="True"/>
            <ComboBoxItem Content="Выбрать файл..."/>
        </ComboBox>
        <Button Content="⌨ Показать/Скрыть клавиатуру" Click="ToggleKeyboard" Padding="10" Background="#E3F2FD"/>
    </StackPanel>
</Window>
