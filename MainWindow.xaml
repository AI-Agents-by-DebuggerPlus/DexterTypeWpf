<Window x:Class="DexterType.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DexterType" Width="850" Height="580" MinWidth="820" MinHeight="520"
        Background="#F6F7F9" FontSize="15"
        PreviewTextInput="OnText" PreviewKeyDown="OnKey">
    <Window.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#F0F2F5"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource ThemeBackground}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1: Stats & Controls (Moved Up) -->
            <RowDefinition Height="120"/>  <!-- 2: Typing Area -->
            <RowDefinition Height="*"/>     <!-- 3: Keyboard -->
            <RowDefinition Height="Auto"/> <!-- 4: Hints (Moved Down) -->
        </Grid.RowDefinitions>
        
        <!-- Typing Area (Now Row 1) -->
        <Border x:Name="TextBorder" Grid.Row="1" Background="{DynamicResource ThemeTextPanel}" BorderBrush="#EEE" BorderThickness="0,0,0,2">
            <Canvas x:Name="TextCanvas" ClipToBounds="True" VerticalAlignment="Center" Height="70">
                <TextBlock x:Name="TextView" FontFamily="Consolas" FontSize="36" Canvas.Top="10"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeMainText}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="TextTransform" X="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Border>

        <!-- Stats & Controls (Now Row 0) -->
        <StackPanel Grid.Row="0" Margin="20,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Скорость: " Foreground="#777"/>
                            <TextBlock x:Name="CpmText" Text="0" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Точность: " Foreground="#777"/>
                            <TextBlock x:Name="AccText" Text="100%" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ErrText" Visibility="Collapsed"/>
                    <TextBlock x:Name="TimeText" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ComboBox x:Name="LayoutBox" Width="120" Margin="0,0,10,0"/>
                    <ComboBox x:Name="LessonBox" Width="180" Margin="0,0,10,0"/>
                    <Button Content="⚙" Width="40" Height="40" Margin="0,0,8,0" Click="OnSettings" Focusable="False"
                            Background="#ECEFF1" BorderThickness="0"/>
                    <Button Content="🔄" Width="40" Height="40" Click="OnRestart" Focusable="False"
                            Background="#E8F5E9" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="HistoryList" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Keyboard Area (Row 2) -->
        <Grid x:Name="KbArea" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,10">
            <StackPanel x:Name="Kb" Opacity="0.9"/>
        </Grid>

        <!-- Hints Area (Now Row 3 - Below Keyboard) -->
        <Border Grid.Row="3" Background="#F0F2F5" Padding="10" Margin="0,0,0,0">
            <TextBlock x:Name="Hint" HorizontalAlignment="Center" 
                       FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50"/>
        </Border>
    </Grid>
</Window>
