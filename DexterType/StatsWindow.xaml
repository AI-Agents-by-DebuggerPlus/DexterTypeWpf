<Window x:Class="DexterType.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистика" Width="880" Height="680" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThemeBackground}" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Border Grid.Row="1" Style="{StaticResource StatCard}" Margin="0" Padding="12">
            <Grid>
                <Canvas x:Name="Chart" ClipToBounds="True" SizeChanged="OnChartSizeChanged"/>
                <TextBlock x:Name="ChartEmpty" Text="Пока нет попыток: пройдите хотя бы один урок."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeSubText}" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StatCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Уроки" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LessonsPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Проблемные символы" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MistakesPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
