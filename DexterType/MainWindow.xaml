<Window x:Class="DexterType.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DexterType.Ui"
        Title="DexterType" Width="1140" Height="720" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackground}"
        FontFamily="Segoe UI" FontSize="14" Focusable="True"
        PreviewTextInput="OnText" PreviewKeyDown="OnKey">
    <DockPanel>

        <!-- Панель инструментов: курсы слева, навигация справа -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemePanel}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="CoursePanel" DockPanel.Dock="Left" Orientation="Horizontal"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="◀ Назад" Click="OnPrev" ToolTip="Предыдущий урок (Ctrl+←)"/>
                    <Button Style="{StaticResource FlatButton}" Content="Вперёд ▶" Click="OnNext" ToolTip="Следующий урок (Ctrl+→)"/>
                    <Button Style="{StaticResource FlatButton}" Content="↻ Заново" Click="OnRepeat" ToolTip="Начать урок заново (Esc)"/>
                    <Button Style="{StaticResource FlatButton}" Content="📊 Статистика" Click="OnStats" ToolTip="Статистика (F7)"/>
                    <Button Style="{StaticResource FlatButton}" Content="⚙ Настройки" Click="OnSettings" ToolTip="Настройки (F2)"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemePanel}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource ThemeSubText}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Список уроков -->
        <Border DockPanel.Dock="Left" Width="280" Background="{DynamicResource ThemeSidebar}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="LessonList" Margin="8,6,8,12"/>
            </ScrollViewer>
        </Border>

        <!-- Рабочая область -->
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Показатели -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <UniformGrid Columns="4" Margin="0,0,-10,0">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="CpmText" Text="0" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CpmCaption" Text="зн/мин" FontSize="12" Foreground="{DynamicResource ThemeSubText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="AccText" Text="100%" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AccCaption" Text="точность" FontSize="12" Foreground="{DynamicResource ThemeSubText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="ErrText" Text="0" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="ошибок" FontSize="12" Foreground="{DynamicResource ThemeSubText}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock x:Name="TimeText" Text="0:00" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="время" FontSize="12" Foreground="{DynamicResource ThemeSubText}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <ProgressBar x:Name="LessonProgress" Height="6" Margin="0,10,10,0" Minimum="0" Maximum="100"
                             BorderThickness="0" Foreground="{DynamicResource ThemeAccent}"
                             Background="{DynamicResource ThemeBorder}"/>
            </StackPanel>

            <!-- Строка с текстом упражнения -->
            <Border Grid.Row="1" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Canvas x:Name="TextCanvas" ClipToBounds="True" SizeChanged="OnTextSizeChanged">
                        <TextBlock x:Name="TextView" FontFamily="Consolas" FontSize="40">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TextTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <TextBlock x:Name="ExerciseLabel" Margin="14,8,0,0" FontSize="12"
                               Foreground="{DynamicResource ThemeSubText}" VerticalAlignment="Top"
                               HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Описание урока -->
            <TextBlock x:Name="IntroText" Grid.Row="2" Margin="2,10,2,0" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource ThemeSubText}"/>

            <!-- Экранная клавиатура -->
            <ui:KeyboardView x:Name="Kb" Grid.Row="3" Margin="0,10,0,10" MaxWidth="860"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Подсказка: какая клавиша и каким пальцем -->
            <Border Grid.Row="4" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="10,8">
                <TextBlock x:Name="Hint" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <!-- Итог урока (поверх текста и клавиатуры) -->
            <Border x:Name="ResultCard" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440" Padding="30,22"
                    Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeAccent}"
                    BorderThickness="2" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ResultTitle" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ResultDetail" Margin="0,12,0,18" FontSize="15" TextAlignment="Center" LineHeight="24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ResultRepeat" Style="{StaticResource FlatButton}" Content="Ещё раз (Esc)"
                                Click="OnRepeat" Padding="18,8"/>
                        <Button x:Name="ResultNext" Style="{StaticResource FlatButton}" Content="Дальше (Enter)"
                                Click="OnResultNext" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
