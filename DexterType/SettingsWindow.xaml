<Window x:Class="DexterType.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="440" Height="700" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ThemeBackground}" FontFamily="Segoe UI" FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemePanel}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Style="{StaticResource FlatButton}" Content="Закрыть" HorizontalAlignment="Right"
                    Padding="24,7" IsDefault="True" IsCancel="True" Click="OnClose"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,16,22,16">

                <TextBlock Text="Тема оформления" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel x:Name="ThemePanel"/>

                <TextBlock Text="Звук ошибок" FontWeight="Bold" Margin="0,18,0,6"/>
                <CheckBox x:Name="SoundCheck" Content="Издавать звук при ошибке и по окончании урока" Click="OnSoundToggle"/>
                <StackPanel x:Name="PackPanel" Margin="0,4,0,0"/>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Громкость" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider x:Name="VolumeSlider" Minimum="5" Maximum="100" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OnVolumeChanged"/>
                </DockPanel>
                <TextBlock Text="Прослушать:" Margin="0,10,0,4" Foreground="{DynamicResource ThemeSubText}"/>
                <WrapPanel x:Name="TestPanel"/>

                <TextBlock Text="Музыка" FontWeight="Bold" Margin="0,18,0,6"/>
                <CheckBox x:Name="MusicCheck" Content="Фоновая музыка" Click="OnMusicToggle"/>
                <DockPanel Margin="0,4,0,0">
                    <Button Style="{StaticResource FlatButton}" DockPanel.Dock="Left" Content="Выбрать файл…"
                            Margin="0,0,10,0" Click="OnChooseMusic"/>
                    <TextBlock x:Name="MusicName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ThemeSubText}"/>
                </DockPanel>

                <TextBlock Text="Интерфейс и прохождение" FontWeight="Bold" Margin="0,18,0,6"/>
                <CheckBox x:Name="KbCheck" Content="Показывать экранную клавиатуру" Click="OnViewToggle"/>
                <CheckBox x:Name="SeqCheck" Content="Открывать уроки по порядку (после зачёта предыдущего)" Click="OnViewToggle"/>

                <TextBlock Text="Данные" FontWeight="Bold" Margin="0,18,0,6"/>
                <Button Style="{StaticResource FlatButton}" Content="Сбросить прогресс текущего курса…"
                        HorizontalAlignment="Left" Margin="0" Click="OnReset"/>
                <TextBlock x:Name="DataPath" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeSubText}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
