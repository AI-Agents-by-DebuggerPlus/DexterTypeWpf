<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DexterType</RootNamespace>
    <AssemblyName>DexterType</AssemblyName>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dexter.Core\Dexter.Core.csproj" />
  </ItemGroup>

  <!-- Курсы лежат рядом с exe в папке Courses; пользовательские курсы можно класть в %AppData%\DexterType\courses -->
  <ItemGroup>
    <Content Include="Courses\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
