<Application x:Class="DexterType.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StartupUri намеренно нет: главное окно создаётся в App.OnStartup после применения темы. -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- Начальные значения (тема «Stamina»); актуальные подставляет Themes.Apply -->
            <SolidColorBrush x:Key="ThemeBackground" Color="#EAF1F7"/>
            <SolidColorBrush x:Key="ThemePanel" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeText" Color="#1F2D3D"/>
            <SolidColorBrush x:Key="ThemeSubText" Color="#6B7C8F"/>
            <SolidColorBrush x:Key="ThemeAccent" Color="#2F80ED"/>
            <SolidColorBrush x:Key="ThemeOnAccent" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ThemeBorder" Color="#C9D6E2"/>
            <SolidColorBrush x:Key="ThemeSidebar" Color="#F4F8FB"/>
            <SolidColorBrush x:Key="ThemeGood" Color="#2E9E5B"/>
            <SolidColorBrush x:Key="ThemeBad" Color="#D64545"/>
            <SolidColorBrush x:Key="ThemeSelected" Color="#332F80ED"/>
            <SolidColorBrush x:Key="ThemeCaret" Color="#FFE680"/>
            <Color x:Key="ColorPinky">#F4B6C2</Color>
            <Color x:Key="ColorRing">#B7E1A1</Color>
            <Color x:Key="ColorMiddle">#FFE08A</Color>
            <Color x:Key="ColorIndex">#9CCBF5</Color>
            <Color x:Key="ColorThumb">#D9D9E3</Color>

            <!-- Текст и простые контролы берут цвет из темы -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            </Style>

            <!-- Плоская кнопка панели инструментов -->
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelected}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Переключатель курса в виде вкладки -->
            <Style x:Key="TabRadio" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource ThemeBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSelected}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Карточка (панель статистики, блоки) -->
            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
